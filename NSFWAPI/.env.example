# Copy to `.env` for local runs. In production this comes from the GitHub
# secret NSFWAPI_ENV (written to nsfwapi.env for docker compose). Never commit
# real values.

NSFW_API_PORT=3004

# Google Vision (SafeSearch + labels). Comma-separated keys rotate on failure.
GOOGLE_VISION_API_KEYS=

# Groq vision captioner - turns uploads into real one-sentence descriptions
# ("A woman standing on an outdoor staircase holding the railing") instead of
# label lists. WITHOUT these keys captions are skipped and descriptions stay
# empty. Free keys: console.groq.com -> API Keys. Comma-separated to rotate.
GROQ_API_KEYS=
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_VISION_TIMEOUT_MS=12000
