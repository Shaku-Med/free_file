# Memories app environment.
#
# Copy this file to .env and fill in the values. The app reads .env every time
# it starts. Push notification keys live in a second file called
# .env.notification, which the build step creates for you the first time, so
# you do not need to add those by hand. See the README for the details.
#
# Keep your real .env private. None of these values ever reach the browser
# unless your own code sends them there.

# ===========================================================================
# Supabase (database and auth). This is the one thing the app cannot start
# without.
# ===========================================================================
# Your project URL, for example https://yourproject.supabase.co
SUPABASE_URL=
# Despite the name, put your SERVICE ROLE key here, not the public anon key.
# The server talks to the database with full rights and scopes every query to
# the signed in user in code. Never expose this value to the browser.
SUPABASE_ANON_KEY=

# ===========================================================================
# Signing secrets. These protect playback tokens, request signatures and the
# server to server calls. Use long random strings, 32 characters or more. If
# any of them are missing the app refuses to sign or verify with a blank key.
# Quick way to make one: openssl rand -base64 48
# ===========================================================================
REQUEST_SIG_SECRET=
SEGMENT_TOKEN_SECRET=
HLS_MANIFEST_GATE_SECRET=
WATCH_PLAYBACK_TOKEN_SECRET=
SERVER_AUTH=
VIDEO_TOKEN=
FILE_TOKEN=
TEMP_TOKEN=
TOKEN1=
TOKEN2=
SERVER_TO_SERVER_KEY=
SERVER_TO_SERVER_KEY_1=
SERVER_TO_SERVER_KEY_2=
AUTHORIZATION_KEY=
PASSWORDS=
C_USER=
SESSION_ID=
DEFAULT_ID=

# ===========================================================================
# File storage. Uploads can live on Cloudflare R2, on GitHub, or both. Fill in
# whichever you actually use.
# ===========================================================================
# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_PRESIGN_TTL_SECONDS=300

# GitHub used as a storage backend
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=YOURREPO
GITHUB_DEFAULT_REPO=YOURREPO
GITHUB_BRANCH=main

# ===========================================================================
# Upload and playback services (the Go side of the project).
# UPLOAD_SERVER_URL and GO_UPLOAD_URL point at GoUpload, which processes the
# uploads. LOADPLAY_BASE_URL points at loadplay, which serves the HLS video.
# UPLOAD_WEBHOOK_SECRET has to match the same value on the Go side.
# ===========================================================================
UPLOAD_SERVER_URL=http://localhost:3003
GO_UPLOAD_URL=http://localhost:3003
LOADPLAY_BASE_URL=http://localhost:3006
UPLOAD_WEBHOOK_SECRET=

# ===========================================================================
# Email. Used for sign in codes and notices. Pick one path: set EMAIL_SERVICE
# to resend and add RESEND_API_KEY, or leave it on smtp and fill the SMTP block.
# ===========================================================================
EMAIL_SERVICE=smtp
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_API_SECRET=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ===========================================================================
# Passkeys and WebAuthn. In local dev the defaults below work. In production
# set these to your real domain.
# ===========================================================================
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=YOURAPPNAME
WEBAUTHN_ORIGIN=http://localhost:3000

# ===========================================================================
# Extras
# ===========================================================================
# GIF picker in the comments
GIPHY_API_KEY=
# Lets search engines know when new pages show up
INDEXNOW_SECRET=
# The extra weekly upload allowance, in bytes. Default here is 10 GiB.
WEEKLY_UPLOAD_LIMIT_BYTES=10737418240
# Public base URL of the app, used in emails and webhooks
APP_BASE_URL=http://localhost:3000
# production or development. Development turns on a few local conveniences.
APP_ENV=development
# Optional extra origins allowed to call the app, comma separated
EXTRA_ALLOWED_ORIGINS=
# Optional. The app itself does not use Redis, the upload pipeline does.
REDIS_URL=

# ===========================================================================
# Runtime
# ===========================================================================
NODE_ENV=development
PORT=3000
# Leave HOST unset to listen on every interface. Set it to 127.0.0.1 to keep
# the server on localhost only (handy when nginx sits in front).
# HOST=127.0.0.1
