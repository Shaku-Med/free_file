apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: free-file
type: Opaque
stringData:
  # IMPORTANT: Replace these with your actual values
  # You can create this secret using:
  # kubectl create secret generic app-secrets --from-env-file=.env -n free-file
  # Or manually edit this file and apply it (NOT recommended for production)
  
  # Example secrets (replace with actual values):
  # DATABASE_URL: "your-database-url"
  # JWT_SECRET: "your-jwt-secret"
  # EMAIL_PASSWORD: "your-email-password"
  # SUPABASE_URL: "your-supabase-url"
  # SUPABASE_KEY: "your-supabase-key"
