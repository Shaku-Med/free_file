# Get a key at https://acoustid.org/new-application (free, non-commercial).
ACOUSTID_API_KEY=

# Only set if fpcalc is not on PATH, e.g.
# FPCALC_BIN=C:\tools\chromaprint\fpcalc.exe
FPCALC_BIN=fpcalc

# AcoustID's own guidance is the first two minutes; longer does not match better.
FINGERPRINT_SECONDS=120

# Our upload ceiling. AcoustID has no file limit because no file is sent to it.
MAX_UPLOAD_MB=60
