# Copy to `acoustid.env` for docker compose (env_file for the acoustid service).
# On the VPS this file is generated from the GitHub secret ACOUSTID_ENV.
# Never commit real values.
#
# Not the same file as AcoustID/.env.example. That one is for bare `python
# src/main.py` on a laptop and only needs the API key. This one is the server
# side and carries the shared secret.
#
# ACOUSTID_API_PORT is forced in docker-compose.yml, not here.

# Shared auth with goupload. Keep equal to ACOUSTID_API_SECRET in compose `.env`.
ACOUSTID_API_SECRET=

# Application API key from https://acoustid.org/new-application (not the user key).
ACOUSTID_API_KEY=

# Same Redis as GoUpload (compose sets REDIS_ADDR=redis:6379).
REDIS_ADDR=redis:6379
# REDIS_PASSWORD=

# APP_BASE_URL and UPLOAD_WEBHOOK_SECRET are injected from compose `.env`
# (same values goupload uses). You can still set them here for bare `python`
# runs outside compose.

# Accept only matches at or above this AcoustID score (0..1).
# 0.99 rejects almost every real YouTube/rip match.
MATCH_MIN_SCORE=0.85

# ~3 lookups/sec per key.
MIN_REQUEST_INTERVAL_SEC=0.34
FINGERPRINT_SECONDS=120
MAX_UPLOAD_MB=60
