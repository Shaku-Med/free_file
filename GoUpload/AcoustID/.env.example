# AcoustID sidecar. Copy to .env and paste your application key.
# These five are the whole file. Everything else the sidecar reads
# (ACOUSTID_API_SECRET, APP_BASE_URL, UPLOAD_WEBHOOK_SECRET, REDIS_ADDR) is
# injected by compose in production and must not be duplicated here.

ACOUSTID_API_KEY=

FPCALC_BIN=fpcalc

FINGERPRINT_SECONDS=120

MAX_UPLOAD_MB=60

# Results and cover art post back through GoUpload, which hosts the image.
# Compose overrides this with http://goupload:3003 on the server.
GOUPLOAD_INTERNAL_URL=http://127.0.0.1:3003
