# Copy to `musicdetector.env` for docker compose (env_file for the musicdetector
# service). On the VPS this file is generated from the GitHub secret
# MUSICDETECTOR_ENV. Never commit real values.
#
# MUSIC_API_PORT and MUSIC_ALLOW_STUB are forced in docker-compose.yml, not here.

# Shared auth with goupload. The deploy workflow also copies this value into the
# compose `.env` so goupload calls the sidecar with the SAME secret. Locally, keep
# it equal to MUSIC_API_SECRET in GoUpload/.env.
MUSIC_API_SECRET=

# Decision gate. is_music = music_ratio >= threshold AND music_seconds >= min.
MUSIC_RATIO_THRESHOLD=0.5
MUSIC_MIN_SECONDS=15
# Only the first N seconds are analyzed (caps CPU per request).
MUSIC_ANALYZE_MAX_SECONDS=180

# Load control. Concurrency = simultaneous analyses; queue = extra requests held
# before returning 503. Threads caps TF/BLAS cores per analysis.
MUSIC_CONCURRENCY=1
MUSIC_MAX_QUEUE=8
MUSIC_THREADS=1
