# Copy to `.env` beside docker-compose.yml (local dev / VPS compose root).
# Never commit `.env`.
#
# CI: deploy-goupload.yml writes /opt/goupload/.env from GitHub secrets
# (EMBED_API_SECRET + image tags). goupload.env / nsfwapi.env / loadplay.env
# come from VPS_ENV, NSFWAPI_ENV, LOADPLAY_ENV.

# Required — shared auth between goupload and embedapi (same value both sides).
EMBED_API_SECRET=
# Required — shared auth between goupload and musicdetector (same value both sides).
MUSIC_API_SECRET=

# Required — public URL of the main app. GoUpload calls
# APP_BASE_URL/api/upload-server-check to verify upload bearers.
APP_BASE_URL=http://localhost:3000
# Optional but recommended — comment-image/thumbnail policy checks and
# file_id→folder resolution. Use the service role key (not anon).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required — must be the SAME value as UPLOAD_WEBHOOK_SECRET in the app's .env.
# Used for quota webhooks AND sent as X-Webhook-Secret on upload-server-check,
# so only GoUpload can call that endpoint. Generate: openssl rand -hex 32
UPLOAD_WEBHOOK_SECRET=

# Image overrides (CI sets these on the VPS; defaults work for local builds).
# GOUPLOAD_IMAGE=ghcr.io/owner/repo/goupload:latest
# NSFWAPI_IMAGE=ghcr.io/owner/repo/nsfwapi:latest
# EMBEDAPI_IMAGE=ghcr.io/owner/repo/embedapi:latest
# MUSICDETECTOR_IMAGE=ghcr.io/owner/repo/musicdetector:latest
# LOADPLAY_IMAGE=ghcr.io/owner/repo/loadplay:latest

GOUPLOAD_PORT=3003
LOADPLAY_PORT=3006
EMBEDAPI_CPUS=0.75
# Multilingual MiniLM needs ~1G; the old bge-small ran in 512M.
EMBEDAPI_MEM=1G
EMBED_THREADS=1

# MusicDetector (inaSpeechSegmenter). Ships TensorFlow, so give it ~1.5G.
MUSICDETECTOR_CPUS=1.0
MUSICDETECTOR_MEM=1536M
MUSIC_THREADS=1
MUSIC_CONCURRENCY=1
MUSIC_MAX_QUEUE=8
MUSIC_RATIO_THRESHOLD=0.5
MUSIC_MIN_SECONDS=15
MUSIC_ANALYZE_MAX_SECONDS=180
