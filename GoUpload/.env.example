# Copy to `.env` beside docker-compose.yml (local dev / VPS compose root).
# Never commit `.env`.
#
# CI: deploy-goupload.yml writes /opt/goupload/.env from GitHub secrets
# (EMBED_API_SECRET + image tags). goupload.env / nsfwapi.env / loadplay.env
# come from VPS_ENV, NSFWAPI_ENV, LOADPLAY_ENV.

# Required — shared auth between goupload and embedapi (same value both sides).
EMBED_API_SECRET=

# Image overrides (CI sets these on the VPS; defaults work for local builds).
# GOUPLOAD_IMAGE=ghcr.io/owner/repo/goupload:latest
# NSFWAPI_IMAGE=ghcr.io/owner/repo/nsfwapi:latest
# EMBEDAPI_IMAGE=ghcr.io/owner/repo/embedapi:latest
# LOADPLAY_IMAGE=ghcr.io/owner/repo/loadplay:latest

GOUPLOAD_PORT=3003
LOADPLAY_PORT=3006
EMBEDAPI_CPUS=0.75
EMBEDAPI_MEM=512M
EMBED_THREADS=1
