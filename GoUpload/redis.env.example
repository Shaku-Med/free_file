# Copy to `redis.env` for local docker compose. Never commit the real file.
#
# On the VPS goupload-compose.sh makes /opt/goupload/redis.env once (root 0600)
# and keeps it across deploys, so it never comes from git or a GitHub secret.
# Compose hands it to redis, goupload and acoustid. Redis refuses to start
# with it empty.
#
# 32 to 128 letters or digits, for example the output of: openssl rand -hex 32
REDIS_PASSWORD=
