# Copy to `goupload.env` for docker compose (env_file for the goupload service).
# On the VPS this file is generated from the GitHub secret VPS_ENV.
# Never commit real values.

APP_ENV=production
REDIS_ADDR=redis:6379
PORT=3003

NSFW_API_URL=http://nsfwapi:3004/api/nsfw/detect

# Adult gate: how many full-resolution frames are SafeSearch'd individually
# (one Google Vision unit each, scored undiluted unlike a grid). Cost per video
# is roughly (this number + 2) Vision units; Google's free tier is 1000/month.
# Default 6 (= 8 units/video, ~125 free videos/month). Max 30.
# VISION_FRAME_SAMPLES=6

# Compose overrides EMBED_API_URL to http://embedapi:3007/embed on the private network.
# EMBED_API_SECRET is injected via compose `.env` (not this file) in production.

# MusicDetector decides is_music. Compose sets MUSIC_API_URL to
# http://musicdetector:3008/analyze and injects MUSIC_API_SECRET via `.env`.
# Unset (e.g. local dev without the sidecar) -> is_music falls back to the stems
# heuristic. MUSIC_PROBE_SECONDS (default 180) caps how much audio is sent.
# MUSIC_PROBE_SECONDS=180

# ── Storage / GitHub / R2 (fill from your deployment) ──
# GITHUB_OWNER=
# GITHUB_REPO=
# UPLOAD_STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# ...

# ── FFmpeg memory governor (Linux) ──
# Under memory pressure the worker pauses newer encodes (SIGSTOP) instead of
# letting the OOM killer crash them, always keeping the oldest encode running
# so pressure drains. ON by default; set to 0 to disable.
# GOUpload_HLS_MEM_GOVERNOR=1
# Pause an encode when MemAvailable drops below this (MB).
# GOUpload_HLS_MEM_PAUSE_MB=400
# Resume a paused encode once MemAvailable recovers above this (MB).
# GOUpload_HLS_MEM_RESUME_MB=700
# Max seconds a retry waits for memory to recover before trying anyway.
# GOUpload_HLS_MEM_RETRY_WAIT_SEC=240
