# NSFWAPI service environment.
#
# Copy this file to .env and fill it in. Never commit your real .env. In
# production it comes from the GitHub secret NSFWAPI_ENV (nsfwapi.env).
#
# This service scores images for adult content and gore, and GoUpload calls it
# during processing. Google Cloud Vision is required. Groq adds captions and the
# gore check; without it a gory upload stays private instead of being refused.

# Port the service listens on. GoUpload talks to it here. Default is 3004.
NSFW_API_PORT=3004

# ===========================================================================
# Groq vision. Add one or more keys. Use GROQ_API_KEYS for a list separated by
# commas (handy for rotating across keys), or GROQ_API_KEY for a single one.
# ===========================================================================
GROQ_API_KEYS=
GROQ_API_KEY=
# Optional. Leave blank to use the built in default (qwen/qwen3.8-27b). It has
# to be a vision model Groq still serves; a retired one fails every call.
GROQ_VISION_MODEL=
# Optional. Defaults to https://api.groq.com/openai/v1/chat/completions
GROQ_VISION_ENDPOINT=
# Optional. Request timeout in milliseconds. Default is 12000.
GROQ_VISION_TIMEOUT_MS=12000

# ===========================================================================
# Google Cloud Vision. One or more API keys, separated by commas for rotation.
# ===========================================================================
GOOGLE_VISION_API_KEYS=
