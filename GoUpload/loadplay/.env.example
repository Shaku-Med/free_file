# Copy to `.env` and fill in. Never commit `.env`.

# Required — shared HMAC secret with the main app (matches app's
# SEGMENT_TOKEN_SECRET so the same token is valid on both sides).
PLAYBACK_TOKEN_SECRET=

# Required — GitHub storage location (same repo GoUpload uploads to).
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# Optional — public origin for manifest rewrite (prod: cdn.memories.brozy.org).
# Dev can leave unset; localhost works via relative /v/... paths.
# PUBLIC_HOST=https://cdn.memories.brozy.org

# Optional — override listen port (default 3006).
PORT=3006
ALLOWED_ORIGINS=
# LoadPlay's own origins — requests with only these as Referer/Origin are rejected (no standalone CDN access).
BLOCKED_ORIGINS=url...
REQUIRE_FINGERPRINT=0
BLOCK_TOOL_UA=1
# Set to 1 to log every successful origin/referer check (rejections always log).
PLAYBACK_DEBUG=1
APP_ENV=development

# Optional Supabase wiring — enables DB-backed access control and the
# per-file `files.github_repo` override. When unset LoadPlay trusts
# the token's owner/file binding and uses GITHUB_REPO above for everything.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# In-memory metadata cache TTLs (segments/manifests reuse RAM; Supabase
# is hit at most once per unique_id per hit window).
# FILE_CACHE_HIT_TTL=15m
# FILE_CACHE_MISS_TTL=30s
